# LLM providers — pick one path:

# A) Fully local (recommended for offline): install https://ollama.com
#    then: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# B) Cloud (optional)
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# LLM_PROVIDER=claude
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash

# No keys + no Ollama = template explanations only (still fully playable)

# Phase 3+
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
